# Optional: URL of a CORS-enabled proxy for the Met Éireann XML endpoint.
# Defaults to /api/met-eireann (Vite dev proxy, Vercel function, Netlify function).
# Set this when deploying to a host without serverless functions (e.g. GitHub Pages).
VITE_MET_EIREANN_PROXY_URL=

# Optional: override the tide provider with an endpoint returning
# { "highTideTime": "HH:MM", "highTideHeight": "3.7m" }.
VITE_TIDES_API_URL=
